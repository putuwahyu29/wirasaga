rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidICEContact(data) {
      return data.name is string && data.name.size() >= 3 && data.name.size() <= 100
             && data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 15
             && data.type in ['Keluarga', 'Teman', 'Pasangan', 'Lainnya']
             && data.userId is string && data.userId == request.auth.uid
             && (data.createdAt == null || data.createdAt is timestamp)
             && data.keys().size() <= 10;
    }

    // Relaxed rules for incidents
    match /incidents/{incidentId} {
      allow read, write: if true;
    }

    // Hardened rules for users
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // Relaxed rules for ice_contacts
    match /ice_contacts/{contactId} {
      allow read, write: if request.auth != null;
    }
  }
}
